        {"t": "il cappello", "b": "cappello", "en": "hat", "ar": "قبّعة", "e": "🎩"},
        {"t": "il calzino", "b": "calzino", "en": "sock", "ar": "جورب", "e": "🧦"},
        {"t": "la sciarpa", "b": "sciarpa", "en": "scarf", "ar": "وشاح", "e": "🧣"},
        {"t": "il cappotto", "b": "cappotto", "en": "coat", "ar": "معطف", "e": "🧥"}
      ],
      "phrases": [
        {"t": "Porto una maglietta rossa.", "en": "I'm wearing a red T-shirt.", "ar": "أرتدي قميصًا أحمر."},
        {"t": "Porto un vestito blu.", "en": "I'm wearing a blue dress.", "ar": "أرتدي فستانًا أزرق."},
