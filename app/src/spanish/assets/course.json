      "title": {"t": "La ropa", "en": "Clothes", "ar": "الملابس"},
      "words": [
        {"t": "la camiseta", "b": "camiseta", "en": "T-shirt", "ar": "قميص قصير", "e": "👕"},
        {"t": "el pantalón", "b": "pantalón", "en": "trousers", "ar": "بنطال", "e": "👖"},
        {"t": "el vestido", "b": "vestido", "en": "dress", "ar": "فستان", "e": "👗"},
        {"t": "el zapato", "b": "zapato", "en": "shoe", "ar": "حذاء", "e": "👟"},
        {"t": "el sombrero", "b": "sombrero", "en": "hat", "ar": "قبّعة", "e": "🎩"},
        {"t": "el calcetín", "b": "calcetín", "en": "sock", "ar": "جورب", "e": "🧦"},
        {"t": "la bufanda", "b": "bufanda", "en": "scarf", "ar": "وشاح", "e": "🧣"},
        {"t": "el abrigo", "b": "abrigo", "en": "coat", "ar": "معطف", "e": "🧥"}
      ],
      "phrases": [
        {"t": "Llevo una camiseta roja.", "en": "I'm wearing a red T-shirt.", "ar": "أرتدي قميصًا أحمر."},
        {"t": "Llevo un vestido azul.", "en": "I'm wearing a blue dress.", "ar": "أرتدي فستانًا أزرق."},
        {"t": "Mi papá lleva un sombrero negro.", "en": "My dad is wearing a black hat.", "ar": "أبي يرتدي قبّعة سوداء."},
        {"t": "¿Llevas zapatos blancos?", "en": "Are you wearing white shoes?", "ar": "هل ترتدين حذاءً أبيض؟"}
      ],
      "tip": {
        "en": "\"Llevo\" means \"I'm wearing\" and \"llevas\" means \"you're wearing\". Remember: the colour comes after and matches: un vestido rojo, una camiseta roja, zapatos rojos.",
        "ar": "\"Llevo\" تعني \"أرتدي\"، و\"llevas\" تعني \"ترتدين\". تذكّري: اللون يأتي بعد الاسم ويوافقه: un vestido rojo، una camiseta roja، zapatos rojos."
      }
    },
    {
      "id": "u11",
      "emoji": "🏡",
      "title": {"t": "La casa", "en": "House & Rooms", "ar": "البيت والغرف"},
      "words": [
        {"t": "la casa", "b": "casa", "en": "house", "ar": "بيت", "e": "🏠"},
        {"t": "la cocina", "b": "cocina", "en": "kitchen", "ar": "مطبخ", "e": "🍳"},
        {"t": "el baño", "b": "baño", "en": "bathroom", "ar": "حمّام", "e": "🛁"},
